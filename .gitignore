# Local environments, dependencies and generated builds. Ignoring preserves
# every local file; it does not delete or modify any original dataset.
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.vite/
dist/
coverage/
htmlcov/
.coverage*
*.tsbuildinfo
*.log
test-results*.xml

# Credentials must never enter this public repository.
.env
.env.*
!.env.example
**/.ssh/
**/credentials*.json
**/*service-account*.json
**/*service_account*.json
*.pem
*.key
*.p12
*.pfx
**/*.private.json
id_rsa*
id_ed25519*

# Original archives, native/bulk raster files and generated databases stay local.
*.zip
*.7z
*.tar
*.tar.gz
*.tif
*.tiff
*.vrt
*.sqlite
*.sqlite-*
*.db
*.db-*
*.tile
*.pending.*
*.part

# Small, real rainfall COGs are intentional source inputs, not DEM previews.
!data/rainfall/*.tif
!handoff/rainfall_supplement/data/rainfall/*.tif

# Only the explicitly listed canonical metadata is versioned from the cache.
/data/cache/*
!/data/cache/*_meta.json
!/data/cache/*_provenance.json
!/data/cache/pluvial_exposure.json
!/data/cache/preflight.json
!/data/cache/revision.txt
!/data/cache/spatial_revision_inputs.json
!/data/cache/whole_scale.json

# Native DTM inputs are restored separately; retain their placeholder README.
/data/external/*
!/data/external/README.md

# Keep small legacy inputs; restore the unchanged large green source from its
# tracked lossless gzip bundle before rebuilding the spatial index.
/data/raw/*
!/data/raw/sofia_infrastructure_points.csv
!/data/raw/vik_kanal_*.geojson

/data/source_bundles/*
!/data/source_bundles/green_areas_original.geojson.gz
!/data/source_bundles/manifest.json

# Keep only small prepared vector partitions needed by prepare_data.py.
/data/derived/*
!/data/derived/green_intersecting_routes.geojson
!/data/derived/sewer_routes_all.geojson
!/data/derived/sewer_routes_inside.geojson
!/data/derived/sewer_routes_outside.geojson
!/data/derived/summary.json

# Bulk national cadastral responses and row-ID lists are acquired/restored
# separately. Their attribution, service metadata and checksum receipts remain.
/data/reference/agkk_buildings/*
!/data/reference/agkk_buildings/agkk_building_catalogue.xml
!/data/reference/agkk_buildings/agkk_building_layer0.json
!/data/reference/agkk_buildings/agkk_building_wms_capabilities.xml
!/data/reference/agkk_buildings/source_metadata_manifest.json

# Research geometry has not been assigned an unverified publication licence.
/data/reference/digital_twin_buildings/Outlines_Roof_Planes_1800.*

# Large source reports remain locally preserved and linked in acquisition
# receipts. Small historical tabular data and survey geometry remain available.
/data/reference/historical_floods/*.pdf
/data/reference/historical_floods/*.xlsx

# Preserve full official assessment inputs locally; reproduce them with
# acquire_flood_assessment.py. The separate browser geometry is versioned.
/data/reference/flood_assessment/originals/
/data/reference/flood_assessment/assessment_zones.geojson
/data/reference/flood_assessment/assessment_zones_display.geojson

# The complete original supplement remains intact locally. Avoid duplicating
# its large raw/prepared vectors and upload archives in the Git source tree.
/handoff/rainfall_supplement/data/raw/
/handoff/rainfall_supplement/data/derived/
/handoff/rainfall_supplement/earth_engine/uploads/
/earth_engine/uploads/

# Full local delivery inventory is generated by packaging, not a Git snapshot.
/MANIFEST_app.json
